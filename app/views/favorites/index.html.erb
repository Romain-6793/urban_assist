<%# app/views/favorites/index.html.erb %>
<div class="container mt-3">
  <%= render "shared/sidebar" %>

  <div class="col-md-9 d-flex flex-column">
    <%= render "shared/topbar" %>

    <div class="p-4 overflow-auto flex-grow-1">
      <% if @favorites.blank? %>
        <p class="text-muted">Aucun favori pour le moment.</p>
      <% else %>
        <div class="cards-grid">
          <% @favorites.each do |f| %>
            <%= render "shared/commune_card",
                commune: f.commune,
                favorite: f,
                chat: nil,
                mode: "favorites" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
